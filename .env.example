# ── Core ─────────────────────────────────────────────────────────────
# Local development: SQLite. Production (Cloudflare + Neon):
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/hirohome?sslmode=require"
DATABASE_URL="file:./dev.db"

# REQUIRED in production. Any long random string — used to sign session cookies.
# Secret: yes — set it in the Cloudflare dashboard, not in git.
JWT_SECRET="change-this-to-a-long-random-string"

# Public URL of the site. Used for verification/reset email links, Google OAuth
# redirect and any absolute links. For preview: http://localhost:3000
# For production: https://<your-app>.pages.dev or your own domain.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Payments (Razorpay) ─────────────────────────────────────────────
# Leave empty to use the built-in demo checkout locally (disabled in production).
# Use rzp_test_... keys first, then switch to live keys.
# Secret: yes — dashboard only.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Secret for the webhook endpoint at /api/webhooks/razorpay.
# Create it in the Razorpay dashboard → Webhooks → secret.
RAZORPAY_WEBHOOK_SECRET=""

# ── Email (Resend) ───────────────────────────────────────────────────
# Without these, verification/reset links are printed to the server console.
# Secret: yes.
RESEND_API_KEY=""
# Sender identity, must belong to a verified domain in Resend.
RESEND_FROM="HiroHome <hello@hirohome.in>"

# ── Google login (optional) ──────────────────────────────────────────
# Secret: yes. Redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Production database seed (npm run db:seed:prod) ──────────────────
# Create the FIRST admin account. Do not commit real values.
# Secret: yes.
ADMIN_NAME=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ── File storage (Cloudflare R2 / S3-compatible) ─────────────────────
# Local development: files are stored in uploads/ on disk.
# Production: REQUIRED — resumes, built PDFs and interview videos live in R2.
# Secret: yes (access/secret keys).
S3_BUCKET="hirohome-uploads"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# R2 endpoint example: https://<accountid>.r2.cloudflarestorage.com
S3_ENDPOINT=""
S3_REGION="auto"
S3_FORCE_PATH_STYLE="false"

# ── Cloudflare (set via dashboard / wrangler secrets) ────────────────
# CLOUDFLARE_ACCOUNT_ID is used by the deploy scripts locally.
# CLOUDFLARE_API_TOKEN is a dashboard API token with Workers + R2 + Pages permissions.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
